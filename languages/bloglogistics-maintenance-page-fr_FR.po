msgid "Maintenance Mode Settings"
msgstr "Réglages du mode maintenance"

msgid "Enable Maintenance Mode"
msgstr "Activer le mode maintenance"

msgid "Custom Maintenance Image"
msgstr "Image de maintenance personnalisée"

msgid "Check this box to put your website into maintenance mode."
msgstr "Cochez cette case pour mettre votre site web en mode maintenance."

msgid "Upload/Select Image"
msgstr "Téléverser/sélectionner une image"

msgid "Remove Image"
msgstr "Supprimer l’image"

msgid "Upload a custom image for your maintenance page. If no image is set, the default image will be used."
msgstr "Téléversez une image personnalisée pour votre page de maintenance. Si aucune image n’est définie, l’image par défaut sera utilisée."

msgid "Maintenance Page"
msgstr "Page de maintenance"

msgid "BlogLogistics"
msgstr "BlogLogistics"

msgid "Use the BlogLogistics submenu items to manage installed BlogLogistics plugins."
msgstr "Utilisez les éléments du sous-menu BlogLogistics pour gérer les extensions BlogLogistics installées."

msgid "BlogLogistics Maintenance Mode"
msgstr "Mode maintenance BlogLogistics"

msgid "Maintenance Mode is ACTIVE!"
msgstr "Le mode maintenance est ACTIF !"

msgid "Your website is currently displaying the maintenance page to all non-administrators. "
msgstr "Votre site web affiche actuellement la page de maintenance à tous les utilisateurs non administrateurs. "

msgid "Go to settings to disable it."
msgstr "Accédez aux réglages pour le désactiver."

msgid "Website Under Maintenance"
msgstr "Site web en maintenance"

msgid "WEBSITE UNDER MAINTENANCE"
msgstr "SITE WEB EN MAINTENANCE"

msgid "This website is under maintenance, we'll be back soon"
msgstr "Ce site web est en maintenance, nous serons bientôt de retour"
